# ============================================
# MADABOUTIQUE - VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# Serveur
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://madaboutique.mg

# Base de données MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/madaboutique?retryWrites=true&w=majority

# JWT Secret (générer une clé aléatoire longue)
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
JWT_EXPIRES_IN=7d

# ============================================
# MVOLA API (Telma Madagascar)
# https://developer.mvola.mg
# ============================================
MVOLA_BASE_URL=https://devapi.mvola.mg
MVOLA_CONSUMER_KEY=votre_consumer_key_mvola
MVOLA_CONSUMER_SECRET=votre_consumer_secret_mvola
MVOLA_MERCHANT_NUMBER=0343500003
MVOLA_CALLBACK_URL=https://votre-api.com/api/payments/mvola/callback

# ============================================
# ORANGE MONEY API (Orange Madagascar)
# https://developer.orange.com/apis/om-webpay-mg
# ============================================
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/mg/v1
ORANGE_MONEY_AUTHORIZATION=Basic votre_base64_auth
ORANGE_MONEY_MERCHANT_KEY=votre_merchant_key
ORANGE_MONEY_NOTIF_URL=https://votre-api.com/api/payments/orange/callback
ORANGE_MONEY_RETURN_URL=https://madaboutique.mg/paiement/confirmation
ORANGE_MONEY_CANCEL_URL=https://madaboutique.mg/paiement/annulation

# ============================================
# AIRTEL MONEY API (Airtel Madagascar)
# https://developers.airtel.africa
# ============================================
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=votre_client_id_airtel
AIRTEL_MONEY_CLIENT_SECRET=votre_client_secret_airtel
AIRTEL_MONEY_COUNTRY=MG
AIRTEL_MONEY_CURRENCY=MGA
AIRTEL_MONEY_CALLBACK_URL=https://votre-api.com/api/payments/airtel/callback

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_app
EMAIL_FROM=MadaBoutique <noreply@madaboutique.mg>
